// use prisma-8

model Rol {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  descripcion String?
  activo      Boolean @default(true)

  usuarios Usuario[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Usuario {
  id       Int     @id @default(autoincrement())
  nombre   String
  apellido String?
  email    String  @unique
  password String
  activo   Boolean @default(true)

  rolId Int
  rol   Rol @relation(fields: [rolId], references: [id])

  importaciones Importacion[]
  auditorias Auditoria[]
  movimientosInventario MovimientoInventario[]
  comprasCreadas Compra[] @relation("CompraCreador")
  comprasRecibidas Compra[] @relation("CompraReceptor")
  ventasCreadas Venta[] @relation("VentaCreador")
  ventasConfirmadas Venta[] @relation("VentaConfirmador")
  devolucionesVentaCreadas DevolucionVenta[] @relation("DevolucionVentaCreador")
  devolucionesVentaProcesadas DevolucionVenta[] @relation("DevolucionVentaProcesador")
  devolucionesCompraCreadas DevolucionCompra[] @relation("DevolucionCompraCreador")
  devolucionesCompraProcesadas DevolucionCompra[] @relation("DevolucionCompraProcesador")

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Categoria {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  descripcion String?
  activo      Boolean @default(true)

  productos Producto[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Producto {
  id           Int     @id @default(autoincrement())
  sku          String  @unique
  codigoBarras String? @unique
  nombre       String
  descripcion  String?

  costo        Decimal
  precio       Decimal
  stockMinimo  Int     @default(0)
  unidadMedida String  @default("PIEZA")
  claveProductoServicioSat String?
  objetoImpuestoSat String?
  unidadMedidaId Int?
  unidadCatalogo UnidadMedida? @relation(fields: [unidadMedidaId], references: [id], onDelete: Restrict)

  activo Boolean @default(true)

  categoriaId Int
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  existencia Existencia?
  movimientosInventario MovimientoInventario[]
  detallesCompra DetalleCompra[]
  precios ProductoPrecio[]
  detallesVenta DetalleVenta[]
  detallesDevolucionVenta DetalleDevolucionVenta[]
  detallesDevolucionCompra DetalleDevolucionCompra[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

enum TipoMovimientoInventario {
  @@type("pg/text@1")
  ENTRADA = "ENTRADA"
  SALIDA = "SALIDA"
  AJUSTE = "AJUSTE"
}

model Existencia {
  id Int @id @default(autoincrement())
  productoId Int @unique
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  cantidad Int @default(0)

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@check(expression: "cantidad >= 0", name: "existencia_cantidad_no_negativa")
}

model MovimientoInventario {
  id Int @id @default(autoincrement())
  productoId Int
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  tipo TipoMovimientoInventario
  cantidad Int
  stockAnterior Int
  stockNuevo Int
  observacion String?
  usuarioId Int
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  createdAt TimestamptzString @default(now())

  @@check(expression: "\"stockAnterior\" >= 0 AND \"stockNuevo\" >= 0", name: "movimiento_stock_no_negativo")
  @@check(expression: "(tipo = 'ENTRADA' AND cantidad > 0 AND \"stockNuevo\"::bigint = \"stockAnterior\"::bigint + cantidad) OR (tipo = 'SALIDA' AND cantidad > 0 AND \"stockNuevo\"::bigint = \"stockAnterior\"::bigint - cantidad) OR (tipo = 'AJUSTE' AND cantidad::bigint = \"stockNuevo\"::bigint - \"stockAnterior\"::bigint)", name: "movimiento_balance")
}

model Proveedor {
  id Int @id @default(autoincrement())
  nombre String
  razonSocial String?
  rfc String? @unique
  email String?
  telefono String?
  direccion String?
  contacto String?
  activo Boolean @default(true)
  compras Compra[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

enum EstadoCompra {
  @@type("pg/text@1")
  BORRADOR = "BORRADOR"
  RECIBIDA = "RECIBIDA"
  CANCELADA = "CANCELADA"
}

model Compra {
  id Int @id @default(autoincrement())
  folio String @unique
  proveedorId Int
  proveedor Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  estado EstadoCompra @default(BORRADOR)
  subtotal Decimal
  impuestos Decimal @default("0")
  total Decimal
  observacion String?
  createdByUsuarioId Int
  creadoPor Usuario @relation("CompraCreador", fields: [createdByUsuarioId], references: [id], onDelete: Restrict)
  recibidaPorUsuarioId Int?
  recibidoPor Usuario? @relation("CompraReceptor", fields: [recibidaPorUsuarioId], references: [id], onDelete: Restrict)
  fechaRecepcion TimestamptzString?
  detalles DetalleCompra[]
  devoluciones DevolucionCompra[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@check(expression: "estado IN ('BORRADOR', 'RECIBIDA', 'CANCELADA')", name: "compra_estado_valido")
  @@check(expression: "subtotal >= 0 AND impuestos >= 0 AND total = subtotal + impuestos", name: "compra_totales_validos")
  @@check(expression: "(estado = 'RECIBIDA' AND \"recibidaPorUsuarioId\" IS NOT NULL AND \"fechaRecepcion\" IS NOT NULL) OR (estado <> 'RECIBIDA' AND \"recibidaPorUsuarioId\" IS NULL AND \"fechaRecepcion\" IS NULL)", name: "compra_recepcion_auditada")
}

model DetalleCompra {
  id Int @id @default(autoincrement())
  compraId Int
  compra Compra @relation(fields: [compraId], references: [id], onDelete: Restrict)
  productoId Int
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  cantidad Int
  costoUnitario Decimal
  subtotal Decimal
  devoluciones DetalleDevolucionCompra[]
  createdAt TimestamptzString @default(now())

  @@unique([compraId, productoId])
  @@check(expression: "cantidad > 0 AND \"costoUnitario\" >= 0 AND subtotal = cantidad * \"costoUnitario\"", name: "detalle_compra_importes_validos")
}

model Cliente {
  id Int @id @default(autoincrement())
  nombre String
  apellido String?
  razonSocial String?
  rfc String? @unique
  email String?
  telefono String?
  direccion String?
  activo Boolean @default(true)
  ventas Venta[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  nombreComercial String?
  regimenFiscal String?
  usoCfdi String?
  numeroRegistroTributario String?
  residenciaFiscal String?
  celular String?
  emailAlterno String?
  domicilioFiscal DomicilioCliente?

}

enum EstadoVenta {
  @@type("pg/text@1")
  BORRADOR = "BORRADOR"
  CONFIRMADA = "CONFIRMADA"
  CANCELADA = "CANCELADA"
}

model Venta {
  listaPrecioId Int?
  listaPrecio ListaPrecio? @relation(fields: [listaPrecioId], references: [id], onDelete: Restrict)
  id Int @id @default(autoincrement())
  folio String @unique
  clienteId Int
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  estado EstadoVenta @default(BORRADOR)
  subtotal Decimal
  impuestos Decimal @default("0")
  total Decimal
  costoTotal Decimal
  utilidad Decimal
  observacion String?
  createdByUsuarioId Int
  creadoPor Usuario @relation("VentaCreador", fields: [createdByUsuarioId], references: [id], onDelete: Restrict)
  confirmadaPorUsuarioId Int?
  confirmadoPor Usuario? @relation("VentaConfirmador", fields: [confirmadaPorUsuarioId], references: [id], onDelete: Restrict)
  fechaConfirmacion TimestamptzString?
  detalles DetalleVenta[]
  devoluciones DevolucionVenta[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@check(expression: "subtotal >= 0 AND impuestos >= 0 AND \"costoTotal\" >= 0 AND total = subtotal + impuestos AND utilidad = subtotal - \"costoTotal\"", name: "venta_importes_validos")
  @@check(expression: "(estado = 'CONFIRMADA' AND \"confirmadaPorUsuarioId\" IS NOT NULL AND \"fechaConfirmacion\" IS NOT NULL) OR (estado <> 'CONFIRMADA' AND \"confirmadaPorUsuarioId\" IS NULL AND \"fechaConfirmacion\" IS NULL)", name: "venta_confirmacion_auditada")
}

model DetalleVenta {
  id Int @id @default(autoincrement())
  ventaId Int
  venta Venta @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  productoId Int
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  cantidad Int
  precioUnitario Decimal
  costoUnitario Decimal
  subtotal Decimal
  costoSubtotal Decimal
  devoluciones DetalleDevolucionVenta[]
  createdAt TimestamptzString @default(now())

  @@unique([ventaId, productoId])
  @@check(expression: "cantidad > 0 AND \"precioUnitario\" >= 0 AND \"costoUnitario\" >= 0 AND subtotal = cantidad * \"precioUnitario\" AND \"costoSubtotal\" = cantidad * \"costoUnitario\"", name: "detalle_venta_importes_validos")
}


enum EstadoDevolucion {
  @@type("pg/text@1")
  BORRADOR = "BORRADOR"
  PROCESADA = "PROCESADA"
  CANCELADA = "CANCELADA"
}

model DevolucionVenta {
  id Int @id @default(autoincrement())
  folio String @unique
  ventaId Int
  venta Venta @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  estado EstadoDevolucion @default(BORRADOR)
  motivo String
  observacion String?
  subtotal Decimal
  costoTotal Decimal
  createdByUsuarioId Int
  creadoPor Usuario @relation("DevolucionVentaCreador", fields: [createdByUsuarioId], references: [id], onDelete: Restrict)
  procesadaPorUsuarioId Int?
  procesadoPor Usuario? @relation("DevolucionVentaProcesador", fields: [procesadaPorUsuarioId], references: [id], onDelete: Restrict)
  fechaProcesamiento TimestamptzString?
  detalles DetalleDevolucionVenta[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@check(expression: "estado IN ('BORRADOR', 'PROCESADA', 'CANCELADA')", name: "devolucion_venta_estado_valido")
  @@check(expression: "subtotal >= 0 AND \"costoTotal\" >= 0", name: "devolucion_venta_importes_validos")
  @@check(expression: "(estado = 'PROCESADA' AND \"procesadaPorUsuarioId\" IS NOT NULL AND \"fechaProcesamiento\" IS NOT NULL) OR (estado <> 'PROCESADA' AND \"procesadaPorUsuarioId\" IS NULL AND \"fechaProcesamiento\" IS NULL)", name: "devolucion_venta_procesamiento_auditado")
  @@check(expression: "length(trim(motivo)) > 0", name: "devolucion_venta_motivo_requerido")
}

model DetalleDevolucionVenta {
  id Int @id @default(autoincrement())
  devolucionVentaId Int
  devolucionVenta DevolucionVenta @relation(fields: [devolucionVentaId], references: [id], onDelete: Restrict)
  detalleVentaId Int
  detalleVenta DetalleVenta @relation(fields: [detalleVentaId], references: [id], onDelete: Restrict)
  productoId Int
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  cantidad Int
  precioUnitario Decimal
  costoUnitario Decimal
  subtotal Decimal
  costoSubtotal Decimal
  createdAt TimestamptzString @default(now())

  @@unique([devolucionVentaId, detalleVentaId])
  @@check(expression: "cantidad > 0 AND \"costoUnitario\" >= 0 AND \"precioUnitario\" >= 0 AND subtotal = cantidad * \"precioUnitario\" AND \"costoSubtotal\" = cantidad * \"costoUnitario\"", name: "detalle_devolucion_venta_importes_validos")
}

model DevolucionCompra {
  id Int @id @default(autoincrement())
  folio String @unique
  compraId Int
  compra Compra @relation(fields: [compraId], references: [id], onDelete: Restrict)
  estado EstadoDevolucion @default(BORRADOR)
  motivo String
  observacion String?
  subtotal Decimal
  createdByUsuarioId Int
  creadoPor Usuario @relation("DevolucionCompraCreador", fields: [createdByUsuarioId], references: [id], onDelete: Restrict)
  procesadaPorUsuarioId Int?
  procesadoPor Usuario? @relation("DevolucionCompraProcesador", fields: [procesadaPorUsuarioId], references: [id], onDelete: Restrict)
  fechaProcesamiento TimestamptzString?
  detalles DetalleDevolucionCompra[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@check(expression: "estado IN ('BORRADOR', 'PROCESADA', 'CANCELADA')", name: "devolucion_compra_estado_valido")
  @@check(expression: "subtotal >= 0", name: "devolucion_compra_importes_validos")
  @@check(expression: "(estado = 'PROCESADA' AND \"procesadaPorUsuarioId\" IS NOT NULL AND \"fechaProcesamiento\" IS NOT NULL) OR (estado <> 'PROCESADA' AND \"procesadaPorUsuarioId\" IS NULL AND \"fechaProcesamiento\" IS NULL)", name: "devolucion_compra_procesamiento_auditado")
  @@check(expression: "length(trim(motivo)) > 0", name: "devolucion_compra_motivo_requerido")
}

model DetalleDevolucionCompra {
  id Int @id @default(autoincrement())
  devolucionCompraId Int
  devolucionCompra DevolucionCompra @relation(fields: [devolucionCompraId], references: [id], onDelete: Restrict)
  detalleCompraId Int
  detalleCompra DetalleCompra @relation(fields: [detalleCompraId], references: [id], onDelete: Restrict)
  productoId Int
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  cantidad Int
  costoUnitario Decimal
  subtotal Decimal
  createdAt TimestamptzString @default(now())

  @@unique([devolucionCompraId, detalleCompraId])
  @@check(expression: "cantidad > 0 AND \"costoUnitario\" >= 0 AND subtotal = cantidad * \"costoUnitario\"", name: "detalle_devolucion_compra_importes_validos")
}

model Auditoria {
  id Int @id @default(autoincrement())
  requestId String
  usuarioId Int?
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  accion String
  entidad String
  entidadId Int?
  descripcion String?
  metadata String?
  createdAt TimestamptzString @default(now())

  @@index([createdAt, id])
  @@check(expression: "length(\"requestId\") = 36 AND length(accion) BETWEEN 1 AND 80 AND length(entidad) BETWEEN 1 AND 80", name: "auditoria_campos_validos")
}

model UnidadMedida {
  id Int @id @default(autoincrement())
  clave String @unique
  nombre String
  activo Boolean @default(true)
  productos Producto[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model DomicilioCliente {
  id Int @id @default(autoincrement())
  clienteId Int @unique
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  pais String?
  codigoPostal String?
  estado String?
  municipio String?
  localidad String?
  colonia String?
  calle String?
  numeroExterior String?
  numeroInterior String?
  referencia String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model ListaPrecio {
  id Int @id @default(autoincrement())
  codigo String @unique
  nombre String
  descripcion String?
  activo Boolean @default(true)
  esPredeterminada Boolean @default(false)
  precios ProductoPrecio[]
  ventas Venta[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@check(expression: "NOT \"esPredeterminada\" OR activo", name: "lista_predeterminada_activa")
  @@index([esPredeterminada], unique: true, where: "\"esPredeterminada\" = true", name: "lista_unica_predeterminada")
}

model ProductoPrecio {
  id Int @id @default(autoincrement())
  productoId Int
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  listaPrecioId Int
  listaPrecio ListaPrecio @relation(fields: [listaPrecioId], references: [id], onDelete: Restrict)
  precio Decimal
  vigenciaDesde TimestamptzString
  vigenciaHasta TimestamptzString?
  activo Boolean @default(true)
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([listaPrecioId, productoId, vigenciaDesde], name: "precio_lista_producto_fecha")
  @@check(expression: "precio >= 0 AND precio <= 1000000000000 AND precio = round(precio, 2)", name: "producto_precio_importe_valido")
  @@check(expression: "\"vigenciaHasta\" IS NULL OR \"vigenciaHasta\" > \"vigenciaDesde\"", name: "producto_precio_vigencia_valida")
}


enum TipoImportacion {
  @@type("pg/text@1")
  CLIENTES = "CLIENTES"
  PRODUCTOS = "PRODUCTOS"
  PRECIOS = "PRECIOS"
}

enum EstadoImportacion {
  @@type("pg/text@1")
  PREVIEW = "PREVIEW"
  PROCESANDO = "PROCESANDO"
  COMPLETADA = "COMPLETADA"
  FALLIDA = "FALLIDA"
  CANCELADA = "CANCELADA"
}

enum EstadoImportacionFila {
  @@type("pg/text@1")
  VALIDA = "VALIDA"
  ADVERTENCIA = "ADVERTENCIA"
  ERROR = "ERROR"
}

model Importacion {
  id Int @id @default(autoincrement())
  tipo TipoImportacion
  estado EstadoImportacion @default(PREVIEW)
  nombreArchivo String
  hashArchivo String
  hashPlan String
  configuracion String
  hojas String
  totalFilas Int
  filasValidas Int
  filasAdvertencia Int
  filasError Int
  usuarioId Int
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  filas ImportacionFila[]
  createdAt TimestamptzString @default(now())
  confirmedAt TimestamptzString?
  completedAt TimestamptzString?
  failedAt TimestamptzString?
  errorCodigo String?

  @@index([createdAt, id])
  @@index([tipo, hashArchivo], unique: true, where: "estado IN ('PREVIEW', 'PROCESANDO', 'COMPLETADA')", name: "importacion_hash_en_uso")
  @@check(expression: "\"totalFilas\" > 0 AND \"filasValidas\" >= 0 AND \"filasAdvertencia\" >= 0 AND \"filasError\" >= 0 AND \"totalFilas\" = \"filasValidas\" + \"filasAdvertencia\" + \"filasError\"", name: "importacion_conteos_validos")
  @@check(expression: "length(\"hashArchivo\") = 64 AND length(\"hashPlan\") = 64", name: "importacion_hash_valido")
  @@check(expression: "(estado = 'COMPLETADA' AND \"confirmedAt\" IS NOT NULL AND \"completedAt\" IS NOT NULL AND \"failedAt\" IS NULL) OR (estado = 'FALLIDA' AND \"failedAt\" IS NOT NULL AND \"completedAt\" IS NULL) OR (estado IN ('PREVIEW', 'CANCELADA') AND \"confirmedAt\" IS NULL AND \"completedAt\" IS NULL AND \"failedAt\" IS NULL) OR (estado = 'PROCESANDO' AND \"confirmedAt\" IS NOT NULL AND \"completedAt\" IS NULL AND \"failedAt\" IS NULL)", name: "importacion_estado_coherente")
}

model ImportacionFila {
  id Int @id @default(autoincrement())
  importacionId Int
  importacion Importacion @relation(fields: [importacionId], references: [id], onDelete: Restrict)
  numeroFila Int
  clave String
  datosNormalizados String
  plan String
  estado EstadoImportacionFila
  errores String
  advertencias String
  resultado String?

  @@unique([importacionId, numeroFila])
  @@index([importacionId, estado], name: "importacion_filas_estado")
  @@check(expression: "\"numeroFila\" > 0", name: "importacion_fila_numero_valido")
}
