# PostgreSQL >= 15. Copiar a .env y reemplazar los ejemplos; no subir secretos.
DATABASE_URL="postgresql://user:password@localhost:5432/inventario"
JWT_SECRET="reemplazar-por-un-secreto-aleatorio-de-al-menos-32-caracteres"
JWT_EXPIRES_IN=8h
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:4200

# Importaciones: archivos en memoria, batch atómico acotado.
IMPORT_MAX_BYTES=2097152
IMPORT_MAX_FILAS=2000
IMPORT_MAX_EXPANDIDO_BYTES=20971520
IMPORT_PREVIEW_HORAS=24
